{
  "version": 2,
  "name": "superalgos",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "Projects/**",
          "Platform/**",
          "Dashboards/**",
          "Social-Trading/**",
          "Network/**",
          "TaskServer/**",
          "App-Management/**",
          "Bitcoin-Factory/**",
          "Plugins/**",
          "Reports/**",
          "Exports/**",
          "Translator/**",
          "migrations/**",
          "*.js",
          "*.json",
          "*.html"
        ]
      }
    },
    {
      "src": "Dashboards/webpack.config.js",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "cd Dashboards && npm run build"
      }
    },
    {
      "src": "Social-Trading/Vue-UI/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "cd Social-Trading/Vue-UI && npm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/dashboards/(.*)",
      "dest": "/Dashboards/UI/vueComponentsBuilt/$1"
    },
    {
      "src": "/social-trading/(.*)",
      "dest": "/Social-Trading/Vue-UI/dist/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/platform.js"
    },
    {
      "src": "/(.*)",
      "dest": "/platform.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "PLATFORM_MODE": "production"
  },
  "functions": {
    "platform.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}